<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>19d8336d-af8a-4d7d-9ac1-baa973935021</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
  </ItemGroup>

  <!--
    Ensures the React app (ClientApp) is built into wwwroot before the backend runs,
    so pressing F5 always serves the latest frontend from a single ASP.NET Core process.
  -->
  <Target Name="EnsureClientAppNodeModules" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\ClientApp\node_modules') And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" />
  </Target>

  <Target Name="BuildClientApp" AfterTargets="EnsureClientAppNodeModules" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingInsideVisualStudio)' == 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" />
  </Target>

</Project>
